# Set these only in the server's secret environment. Never use NEXT_PUBLIC_.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_AUTH_METHOD=LOGIN
SMTP_USER=golwebstudio@bk.ru
SMTP_PASS=
SMTP_FROM=golwebstudio@bk.ru
MAIL_TO=golwebstudio@bk.ru

# SMTP_PASSWORD is a supported alias for SMTP_PASS.
# LEAD_TO_EMAIL is a supported alias for MAIL_TO.
# Set one name per pair; conflicting values block sending.

# Legacy YANDEX_* credentials are not used. smtp:setup removes conflicting definitions.

# LexRadar stays disabled until controlled end-to-end delivery and proxy checks pass.
LEXRADAR_FORM_ENABLED=false
LEXRADAR_SITE_ORIGIN=https://www.golwebstudio.ru
LEXRADAR_ABUSE_MODE=
LEXRADAR_TRUST_PROXY=false
LEXRADAR_CLIENT_IP_HEADER=
LEXRADAR_EDGE_RATE_LIMIT_CONFIRMED=false

# Optional owner notifications; server-only. Configure later via telegram:setup.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
